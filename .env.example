# Copy this file to .env and fill in your values
# cp .env.example .env

# Required
OPENAI_API_KEY=sk-...
SECRET_KEY=change-me-to-a-random-secret

# Database — point at an existing MySQL instance (Docker Compose does not spin one up)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=food_recognition

# OIDC login (Authentik) — client_id/secret/issuer from the app's OAuth2
# Provider in Authentik. Only needed without Vault (see CLAUDE.md "Vault
# secrets"); the app has no login without one or the other configured.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=http://192.168.0.59:9000/application/o/food-recognition/

# Optional
DEFAULT_DAYS=30
DB_TZ_DATES=UTC
WAIT_TIME_OPEANAI_API=5
